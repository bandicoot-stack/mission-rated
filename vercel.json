{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": true
  },
  "redirects": [
    {
      "source": "/go/yorktown",
      "destination": "/family-pass.html?utm_source=partner&utm_medium=business-share&utm_campaign=military-family-growth&mr_partner=yorktown-tools",
      "permanent": false
    },
    {
      "source": "/go/compassrose",
      "destination": "/family-pass.html?utm_source=partner&utm_medium=business-share&utm_campaign=military-family-growth&mr_partner=compass-rose-realty-co",
      "permanent": false
    },
    {
      "source": "/go/valhalla",
      "destination": "/family-pass.html?utm_source=partner&utm_medium=business-share&utm_campaign=military-family-growth&mr_partner=valhalla-barbell-club",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/release.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
